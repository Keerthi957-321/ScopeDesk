# ScopeDesk settings. On Railway you add these under Service > Variables (see RAILWAY.md); there is no .env file in production.
# For local development only, copy this file to ".env" next to server.js. Never share or commit .env.

# ---- Strongly recommended in production (Railway) ----
# Long random string used to sign logins. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If you forget it the server STILL STARTS: it generates a random secret and saves it next to the database (see server/net-config.js).
# That saved secret only survives redeploys when DB_PATH is on a Railway Volume, so set JWT_SECRET to keep everyone signed in.
JWT_SECRET=
# Where the database lives. Add a Railway Volume mounted at /data, then use:
DB_PATH=/data/scopedesk.db

# ---- Optional ----
# Railway sets PORT itself. Public address used in password-reset emails (defaults to Railway's generated domain).
# APP_URL=https://your-app.up.railway.app
# Extra website addresses allowed to call the API and Socket.IO, comma separated. "*.example.com" allows every https subdomain.
# *.vercel.app, *.github.io, *.netlify.app and *.up.railway.app are already allowed by default.
# CORS_ORIGIN=https://scopedesk.example.com
# Create the demo accounts office_admin / it_vendor (password Password123!). Never on a public server.
# SEED_DEMO=true

# ---- Password-reset emails (Gmail example) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
# A Gmail "App Password" (16 letters), NOT your normal Gmail password
SMTP_PASS=
MAIL_FROM=ScopeDesk <your.address@gmail.com>

# ---- WebRTC relay (strongly recommended for production: vendors and clients are on different networks) ----
# With a coturn server (use-auth-secret) the stream is relayed and its credentials expire when the task window ends.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=your-coturn-static-auth-secret
# TURN_FORCE_RELAY=true

# Keep the WebRTC stream running after a security violation until the Client presses "Terminate Session Now"
# AUTO_CUT_STREAM=false
# A violation locks the vendor out for good. Set true to let the Client resume the session instead.
# ALLOW_RESUME_AFTER_VIOLATION=false

# ---- WebRTC relay (TURN): needed when Client and Vendor are on DIFFERENT networks ----
# Cloudflare Realtime TURN (recommended, first 1,000 GB a month free). Dashboard > Realtime > TURN Server > Create:
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# or Metered (free account):  METERED_APP=<your app name>  METERED_API_KEY=<API key>
# or your own coturn:  TURN_URLS=turn:turn.example.com:3478  with  TURN_SECRET=...   (or TURN_USERNAME + TURN_CREDENTIAL)

# ---- WebRTC path selection (3.3) ----
# Default is the hybrid policy "all": local (same Wi-Fi), STUN (public address) and TURN (relay) candidates are gathered together.
# With no relay configured above, a shared public relay (Open Relay) is added as a best-effort fallback. Turn it off with:
# PUBLIC_TURN_FALLBACK=false
# Strict mode: relay-only (the stream cannot outlive its TURN credentials). Slower, uses relay bandwidth, no direct/LAN path.
# TURN_FORCE_RELAY=true
